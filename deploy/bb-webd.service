[Unit]
Description=Building Blocks - Web Dashboard
Documentation=https://github.com/hfgdwuyi/nxp-imx95-building-blocks
After=network.target bb-busd.service
Wants=network.target bb-busd.service

[Service]
Type=simple
ExecStart=/opt/building-blocks/bin/bb-webd 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/building-blocks
ReadOnlyPaths=/proc /sys /dev /run
PrivateTmp=yes
PrivateDevices=no

# Resource limits
MemoryMax=32M
TasksMax=32

[Install]
WantedBy=multi-user.target

[Unit]
Description=Building Blocks - System Health Monitor
Requires=bb-busd.service
After=bb-busd.service

[Service]
Type=simple
ExecStart=/opt/building-blocks/bin/bb-cli pub /system/health '{"status":"ok"}'
Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bb-health

[Install]
WantedBy=multi-user.target
